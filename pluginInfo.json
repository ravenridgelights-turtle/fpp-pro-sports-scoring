  "allowUpdates": 1,
  "releaseNotesStyle": "gitHistory",
  "privacy": {
    "summary": "Checks ESPN for the selected teams and game scores so FPP can trigger local sequences.",
    "sends": [
      {
        "to": "site.api.espn.com",
        "what": "selected team IDs and ESPN game IDs",
        "why": "to retrieve schedules, scores and scoring plays",
        "alwaysOn": false
      }
    ],
    "collects": [],
    "sensors": [],
    "remoteAccess": "none",
    "systemChanges": [],
    "closedCode": false,
    "other": "ESPN's Site API is unofficial and may change without notice."
  },

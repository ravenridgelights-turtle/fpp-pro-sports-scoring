{
  "repoName": "fpp-nfl",
  "name": "Pro Sports Scoring Plugin",
  "author": "Ben Kools (koolsb), maintained by ravenridgelights-turtle",
  "description": "Automatically play an FPP sequence when your NFL, NCAA Football, NHL, or MLB team scores or wins.",
  "homeURL": "https://github.com/ravenridgelights-turtle/fpp-pro-sports-scoring",
  "srcURL": "https://github.com/ravenridgelights-turtle/fpp-pro-sports-scoring.git",
